<script>
  

document.getElementById('authorName').textContent = CONFIG.authorName;
document.getElementById('bookTitle').textContent = CONFIG.bookTitle;
document.getElementById('chatHeadTitle').textContent = "Chat with " + CONFIG.authorName.split(' ')[0];
document.getElementById('initials').textContent = CONFIG.authorInitials;
document.title = CONFIG.pageTitle;

if(CONFIG.authorPhotoURL){
  const inner = document.querySelector('.photo-inner');
  inner.innerHTML = '<img src="'+CONFIG.authorPhotoURL+'" alt="'+CONFIG.authorName+'">';
}

(function renderAuthorBtn(){
  const btn = document.getElementById('authorBtn');
  if(!btn) return;
  const url = (CONFIG.authorURL || '').trim();
  const usable = url && url !== '#' && url.indexOf('{{') === -1;
  if(!usable){ btn.remove(); return; }
  btn.href = /^https?:\/\//i.test(url) ? url : 'https://' + url;
  btn.hidden = false;
})();


(function renderPresenceLinks(){
  const wrap = document.getElementById('presenceLinks');
  function renderGroup(show, items, singleLabel, multiLabel, btnClass){
    if(show !== true) return;
    const list = (items || []).filter(x => x.url && x.url.trim() && x.url.trim() !== '#');
    if(!list.length) return;

  
    const holder = document.createElement('div');
    holder.className = 'book-menu-wrap';
  
    const menu = document.createElement('div');
    menu.className = 'book-menu';
    list.forEach(item => {
      const a = document.createElement('a');
      a.href = item.url.trim(); a.target = '_blank'; a.rel = 'noopener';
      a.textContent = item.title;
      menu.appendChild(a);
    });
  
    const trigger = document.createElement('button');
    trigger.type = 'button';
    trigger.className = 'presence-btn ' + btnClass;
    trigger.textContent = list.length === 1 ? singleLabel : multiLabel;
    trigger.addEventListener('click', e => {
      e.preventDefault();
      wrap.querySelectorAll('.book-menu-wrap.open').forEach(o => { if(o !== holder) o.classList.remove('open'); });
      holder.classList.toggle('open');
    });
  
    holder.appendChild(menu);
    holder.appendChild(trigger);
    wrap.appendChild(holder);
  
    document.addEventListener('click', e => { if(!holder.contains(e.target)) holder.classList.remove('open'); });
  }
  renderGroup(CONFIG.showBooks,   CONFIG.books,   'Buy the Book',   'Buy the Books',   'primary');
  renderGroup(CONFIG.showCourses, CONFIG.courses, 'Buy the Course', 'Buy the Courses', 'secondary');
})();

/* =========================================================================
   Chat wiring
   ========================================================================= */
const messagesEl = document.getElementById('messages');
const input = document.getElementById('input');
const sendBtn = document.getElementById('sendBtn');
const micBtn = document.getElementById('micBtn');
const voiceNote = document.getElementById('voiceNote');
/* --- duplicate-send guards --- */
let isSending   = false;                    // one in-flight turn at a time
let turnHandled = false;                    // one auto-send per mic session
let lastSent    = { text: '', at: 0 };
const DEBUG = location.search.includes('debug=1');
function dlog(...a){ if(DEBUG) console.log('[coach]', ...a); }

/* =========================================================================
   Voice OUTPUT (browser text-to-speech — no avatar, just spoken audio).
   ========================================================================= */
let voiceOutEnabled = true;
const speakerBtn = document.getElementById('speakerBtn');
const restartBtn = document.getElementById('restartBtn');
const speakerIconOn = document.getElementById('speakerIconOn');
const speakerIconOff = document.getElementById('speakerIconOff');

function speak(text){
  if(!voiceOutEnabled || !text) return;
  if(!('speechSynthesis' in window)) return;
  window.speechSynthesis.cancel(); // stop any reply still being read
  const utter = new SpeechSynthesisUtterance(text);
  utter.rate = 1;
  utter.pitch = 1;
  utter.lang = 'en-US';
  window.speechSynthesis.speak(utter);
}

// Plays the coach's spoken audio in order. Falls back to the browser's
// built-in voice only if no audio came back for this turn (silent to the
// visitor either way — no vendor name shown on screen).
let currentAudioEl = null;
function playCoachAudio(audioSrcs, fallbackText){
  if(!voiceOutEnabled) return;
  if(currentAudioEl){ currentAudioEl.pause(); currentAudioEl = null; }
  if(!audioSrcs || !audioSrcs.length){
    speak(fallbackText); // no coach audio came back — degrade gracefully
    return;
  }
  let i = 0;
  const playNext = () => {
    if(i >= audioSrcs.length) return;
    const audio = new Audio(audioSrcs[i]);
    currentAudioEl = audio;
    i++;
    audio.addEventListener('ended', playNext);
    audio.play().catch(err => console.error('Audio playback failed:', err));
  };
  playNext();
}

speakerBtn.addEventListener('click', () => {
  voiceOutEnabled = !voiceOutEnabled;
  speakerIconOn.style.display = voiceOutEnabled ? 'block' : 'none';
  speakerIconOff.style.display = voiceOutEnabled ? 'none' : 'block';
  if(!voiceOutEnabled){
    window.speechSynthesis.cancel();
    if(currentAudioEl){ currentAudioEl.pause(); currentAudioEl = null; }
  }
});

restartBtn.addEventListener('click', async () => {
  if(!confirm('Start a new conversation? This clears what is on screen.')) return;



  // 2. Clear the window.
  messagesEl.innerHTML = '';

  // 3. Wipe Voiceflow's server-side state, so variables set earlier in the
  //    conversation do not survive. A launch alone restarts the FLOW but may
  //    leave variables populated.
  try{
    await coachReset();
  }catch(e){ console.error('state reset failed', e); }

  // 4. Fresh greeting. The identity deliberately survives - same person,
  //    new conversation - so transcript history and cid continuity hold.
  await launchCoach();
});

function addMessage(text, who){
  const div = document.createElement('div');
  div.className = 'msg ' + who;
  const label = document.createElement('span');
  label.className = 'msg-label';
  label.textContent = who === 'user' ? 'You' : 'Coach';
  div.appendChild(label);
  div.appendChild(document.createTextNode(text));
  messagesEl.appendChild(div);
  messagesEl.scrollTop = messagesEl.scrollHeight;
  return div;
}


function showTyping(){
  const div = document.createElement('div');
  div.className = 'typing';
  div.id = 'typingIndicator';
  div.innerHTML = '<span></span><span></span><span></span>';
  messagesEl.appendChild(div);
  messagesEl.scrollTop = messagesEl.scrollHeight;
}
function hideTyping(){
  const t = document.getElementById('typingIndicator');
  if(t) t.remove();
}

// The member, when the lesson iframe passed them through (?cid=&em=). Read
// here, before the activation script strips them from the address bar.
const MEMBER = (function () {
  var q = null;
  try { q = new URLSearchParams(location.search); } catch (e) {}
  var cid = q ? (q.get('cid') || '').trim() : '';
  var em  = q ? (q.get('em')  || '').trim() : '';
  // Same {{ guard the activation box uses. An unresolved merge field is NOT an
  // identity — without this check, every member whose {{contact.id}} failed to
  // render would share one Voiceflow user, and therefore one conversation.
  if (cid && em && cid.indexOf('{{') === -1 && em.indexOf('{{') === -1) return { contactId: cid, email: em };
  return null;
})();

// CONFIG.CONNECTION - see the CONFIG block at the top. Anything other than
// "direct" means the Worker.
const USE_DIRECT = String(CONFIG.CONNECTION || 'worker').toLowerCase() === 'direct';
if(USE_DIRECT && !CONFIG.VF_API_KEY){
  console.error('[coach] CONNECTION is "direct" but VF_API_KEY is empty - the coach cannot connect.');
}

// Worker mode: only used WITHOUT a verified session. A verified member is
// identified by the Worker from the session as `ghl_<contactId>`, and this
// value is ignored. Deliberately never derived from the contactId there: a
// member whose session could not be verified would otherwise share a
// guessable fallback conversation with anyone who typed their contactId.
//
// Direct mode: there is no Worker to verify anyone, so the member IS
// `ghl_<contactId>` - the ID SMS and calls use - which keeps one conversation
// across channels. Visitors without a cid get a per-browser ID.
const VF_USER_ID = (function () {
  if (USE_DIRECT && MEMBER) return 'ghl_' + MEMBER.contactId;
  try {
    var saved = localStorage.getItem('bc_vf_uid');
    if (saved) return saved;
    var made = 'web_' + Math.random().toString(36).slice(2) + '_' + Date.now();
    localStorage.setItem('bc_vf_uid', made);
    return made;
  } catch (e) {
    // Private mode or blocked storage: fall back to the old behaviour rather
    // than breaking the page.
    return 'web_' + Math.random().toString(36).slice(2) + '_' + Date.now();
  }
})();

// --- Verified session --------------------------------------------------------
// The Worker trades contactId + email for a short-lived session token, after
// checking the email matches the contact and the contact holds this coach.
// That token is what makes the Worker treat this viewer as the member. Cached
// for its lifetime (in memory and sessionStorage) so a reload doesn't re-verify.
let _session = null;          // { token, until }
let _sessionInflight = null;
let _sessionRefused = false;  // not entitled: stop asking for this page load
const SESSION_KEY = 'bc_wtok_' + CONFIG.COACH_CODE + '_' + (MEMBER ? MEMBER.contactId : '');

function getSessionToken(){
  if(!MEMBER || _sessionRefused) return Promise.resolve('');
  if(_session && _session.until > Date.now()) return Promise.resolve(_session.token);
  if(!_session){
    try{
      const c = JSON.parse(sessionStorage.getItem(SESSION_KEY) || 'null');
      if(c && c.token && c.until > Date.now()){ _session = c; return Promise.resolve(c.token); }
    }catch(e){}
  }
  if(_sessionInflight) return _sessionInflight;
  _sessionInflight = (async () => {
    try{
      const res = await fetch(CONFIG.WORKER_URL + '/api/web/session', {
        method: 'POST', headers: { 'content-type': 'application/json' },
        body: JSON.stringify(MEMBER)
      });
      if(res.status === 403){ _sessionRefused = true; return ''; }
      if(!res.ok) return '';
      const b = await res.json();
      if(!b || !b.token) return '';
      // Renew five minutes early so a turn never goes out on a dying token.
      _session = { token: b.token, until: Date.now() + ((b.expiresInSeconds || 7200) - 300) * 1000 };
      try{ sessionStorage.setItem(SESSION_KEY, JSON.stringify(_session)); }catch(e){}
      return b.token;
    }catch(e){
      console.error('session request failed', e);
      return '';
    }finally{
      _sessionInflight = null;
    }
  })();
  return _sessionInflight;
}

// Every coach call goes through here: POST to the Worker with the coach code,
// the session token (when there is one) and the hint ID.
async function workerPost(path, body){
  const token = await getSessionToken();
  const payload = Object.assign({ code: CONFIG.COACH_CODE, userID: VF_USER_ID }, body);
  if(token) payload.sessionToken = token;
  const res = await fetch(CONFIG.WORKER_URL + path, {
    method: 'POST',
    headers: { 'content-type': 'application/json' },
    body: JSON.stringify(payload)
  });
  if(!res.ok){
    throw new Error('Coach service responded with status ' + res.status);
  }
  return res.json();
}

// --- Direct mode: straight to Voiceflow ---------------------------------------
const VF_RUNTIME = 'https://general-runtime.voiceflow.com';
function vfHeaders(){
  return { 'Authorization': CONFIG.VF_API_KEY, 'Content-Type': 'application/json', 'versionID': CONFIG.VF_VERSION_ID };
}
// SMS and calls set Voiceflow's `channel` to sms/voice on a shared conversation.
// The Worker resets it to web on every web turn; in direct mode the page must,
// once per page load, or web replies could come back SMS-formatted.
let _channelSet = null;
function directSetChannel(){
  if(!_channelSet){
    _channelSet = fetch(`${VF_RUNTIME}/state/user/${encodeURIComponent(VF_USER_ID)}/variables`, {
      method: 'PATCH', headers: vfHeaders(), body: JSON.stringify({ channel: 'web' })
    }).catch(e => console.error('channel reset failed', e));
  }
  return _channelSet;
}

// --- The three things the page asks of the coach, in either mode -------------

async function vfInteract(action){
  // tts:true asks Voiceflow to render audio using the voice configured on the
  // project itself (Project Settings > Voice), returned as a src on each
  // "speak" trace — the natural voice, not a browser voice.
  if(USE_DIRECT){
    await directSetChannel();
    const res = await fetch(`${VF_RUNTIME}/state/${CONFIG.VF_VERSION_ID}/user/${encodeURIComponent(VF_USER_ID)}/interact`, {
      method: 'POST', headers: vfHeaders(), body: JSON.stringify({ action, config: { tts: true } })
    });
    if(!res.ok) throw new Error('Voiceflow responded with status ' + res.status);
    const traces = await res.json();
    return Array.isArray(traces) ? traces : [];
  }
  const out = await workerPost('/api/vf-interact', { action, tts: true });
  return (out && Array.isArray(out.traces)) ? out.traces : [];
}

// Wipe the conversation ("Start a new conversation").
async function coachReset(){
  if(USE_DIRECT){
    await fetch(`${VF_RUNTIME}/state/user/${encodeURIComponent(VF_USER_ID)}`, { method: 'DELETE', headers: vfHeaders() });
    _channelSet = null; // state is gone; set channel again on the next turn
    return;
  }
  await workerPost('/api/vf-state', { op: 'reset' });
}
// Saves this session to the project's Transcripts tab in Voiceflow.
// Fire-and-forget: if it fails, the chat still works.

// Pulls spoken text out of a trace list, and renders any link buttons
// (e.g. the Resource & Referral Concierge's "Get the Book" card) inline
// in the messages panel.
// Walks any nested object/array looking for values that look like audio
// (data URIs, or URLs ending in a common audio extension) — used because
// the exact field name Voiceflow uses for TTS audio can vary by trace type.
function findAudioSrcs(node, found){
  found = found || [];
  if(!node) return found;
  if(typeof node === 'string'){
    if(node.startsWith('data:audio') || /\.(mp3|wav|ogg|m4a)(\?|$)/i.test(node)){
      found.push(node);
    }
    return found;
  }
  if(Array.isArray(node)){
    node.forEach(item => findAudioSrcs(item, found));
    return found;
  }
  if(typeof node === 'object'){
    Object.values(node).forEach(v => findAudioSrcs(v, found));
  }
  return found;
}

function extractReplyAndButtons(traces){
  const textParts = [];
  const buttons = [];
  const audioSrcs = [];

  traces.forEach(t => {
    if((t.type === 'text' || t.type === 'speak') && t.payload && t.payload.message){
      textParts.push(t.payload.message);
    }
    // Card / carousel traces carry open_url buttons in slightly different
    // shapes depending on how they were built — check the common spots.
    const candidateButtons = (t.payload && (t.payload.buttons || (t.payload.cards && t.payload.cards[0] && t.payload.cards[0].buttons))) || [];
    candidateButtons.forEach(b => {
      const label = b.name || b.text || 'Open link';
      const action = (b.request && b.request.payload && b.request.payload.actions && b.request.payload.actions[0]) || {};
      const url = (action.payload && action.payload.url) || (b.request && b.request.payload && b.request.payload.url);
      if(url) buttons.push({ label, url });
    });
  });

  // Broad sweep for any audio-looking value anywhere in the trace payloads.
  audioSrcs.push(...findAudioSrcs(traces));

  return { text: textParts.join(' '), buttons, audioSrcs };
}

function addLinkButtons(buttons){
  if(!buttons.length) return;
  const wrap = document.createElement('div');
  wrap.className = 'msg coach';
  wrap.style.display = 'flex';
  wrap.style.flexWrap = 'wrap';
  wrap.style.gap = '8px';
  buttons.forEach(b => {
    const a = document.createElement('a');
    a.href = b.url;
    a.target = '_blank';
    a.rel = 'noopener';
    a.textContent = b.label;
    a.style.cssText = 'background:var(--brand-blue);color:#fff;text-decoration:none;padding:8px 14px;border-radius:100px;font-size:13px;font-weight:600;';
    wrap.appendChild(a);
  });
  messagesEl.appendChild(wrap);
  messagesEl.scrollTop = messagesEl.scrollHeight;
}

async function sendToCoach(text){
  try{
    const traces = await vfInteract({ type: 'text', payload: text });
    const { text: reply, buttons, audioSrcs } = extractReplyAndButtons(traces);
    if(buttons.length) setTimeout(() => addLinkButtons(buttons), 50);
    return { reply: reply || "…", audioSrcs };
  }catch(err){
    console.error(err);
    return { reply: "I couldn't reach the coach service just now. Please try again in a moment.", audioSrcs: [] };
  }
}

// Kick off the Voiceflow session on page load so state exists before the
// first real message, and swap in the coach's actual launch greeting.
async function launchCoach(){
  showTyping();
  try{
    const traces = await vfInteract({ type: 'launch' });
    const { text, buttons, audioSrcs } = extractReplyAndButtons(traces);
    hideTyping();
    if(text){
      addMessage(text, 'coach');
      playCoachAudio(audioSrcs, text);
    }
    if(buttons.length) addLinkButtons(buttons);
  }catch(err){
    hideTyping();
    console.error('Launch failed:', err);
    addMessage("I'm having trouble connecting right now — please refresh in a moment.", 'coach');
  }
}

// --- restore the conversation from Voiceflow's own memory on page load ---
// Direct mode reads Voiceflow's state as-is. Worker mode gets only
// { live, memory } - never the whole state - reshaped to what bootCoach expects.
// With shared memory on, this history includes the member's texts and calls.
async function fetchState(){
  try{
    if(USE_DIRECT){
      const res = await fetch(`${VF_RUNTIME}/state/user/${encodeURIComponent(VF_USER_ID)}`, { headers: vfHeaders() });
      if(!res.ok) return null;
      return await res.json();
    }
    const out = await workerPost('/api/vf-state', { op: 'get' });
    if(!out) return null;
    return { stack: out.live ? [{}] : [], variables: out.memory || {} };
  }catch(e){ return null; }
}

// Turn Voiceflow's memory into [{w:'user'|'coach', t:'...'}]
function memoryToMessages(vars){
  vars = vars || {};
  let out = [];

  // 1. Structured memory (_memory_), if present
  const mem = vars._memory_;
  if(Array.isArray(mem)){
    mem.forEach(m => {
      if(!m) return;
      const role = String(m.role || '').toLowerCase();
      let text = m.content;
      if(Array.isArray(text)) text = text.map(p => (p && p.text) || '').join(' ');
      if(typeof text !== 'string') text = m.text || m.message || '';
      text = String(text).trim();
      if(!text) return;
      if(role === 'user') out.push({ w: 'user', t: text });
      else if(role === 'assistant') out.push({ w: 'coach', t: text });
    });
  }

  // 2. Fallback: the vf_memory text, one "assistant:" / "user:" line per turn
  if(!out.length && typeof vars.vf_memory === 'string'){
    vars.vf_memory.split('\n').forEach(line => {
      const m = line.match(/^(assistant|user):\s?(.*)$/i);
      if(m) out.push({ w: m[1].toLowerCase() === 'user' ? 'user' : 'coach', t: m[2] });
      else if(out.length) out[out.length - 1].t += '\n' + line;   // multi-line message
    });
    out = out.map(m => ({ w: m.w, t: m.t.trim() })).filter(m => m.t);
  }

  // Match the live view: consecutive coach messages share one bubble
  const merged = [];
  out.forEach(m => {
    const last = merged[merged.length - 1];
    if(last && last.w === 'coach' && m.w === 'coach') last.t += ' ' + m.t;
    else merged.push({ w: m.w, t: m.t });
  });
  return merged;
}

// Live conversation: show it and do NOT launch (launch restarts the flow).
// No conversation, or anything fails: fresh greeting as before.
async function bootCoach(){
  showTyping();
  const state = await fetchState();
  hideTyping();

  const live = !!(state && Array.isArray(state.stack) && state.stack.length);
  const history = live ? memoryToMessages(state.variables) : [];

  if(history.length){
    history.forEach(m => addMessage(m.t, m.w));
    return;
  }
  launchCoach();
}

if(!window.__bookCoachLaunched){ window.__bookCoachLaunched = true; bootCoach(); }

async function handleSend(){
  const text = input.value.trim();
  if(!text) return;
  const now = Date.now();

  if(isSending){ dlog('blocked: send in flight', text); return; }
  if(text === lastSent.text && now - lastSent.at < 4000){
    dlog('blocked: duplicate within 4s', text);
    input.value = ''; input.style.height = 'auto';
    return;
  }

  isSending = true;
  lastSent = { text, at: now };
  sendBtn.disabled = true;

  addMessage(text, 'user');
  input.value = '';
  input.style.height = 'auto';
  showTyping();
  try{
    const { reply, audioSrcs } = await sendToCoach(text);
    hideTyping();
    addMessage(reply, 'coach');
    playCoachAudio(audioSrcs, reply);
  } finally {
    isSending = false;
    sendBtn.disabled = false;
  }
}

sendBtn.addEventListener('click', handleSend);
input.addEventListener('keydown', (e) => {
  if(e.key === 'Enter' && !e.shiftKey){
    e.preventDefault();
    handleSend();
  }
});
input.addEventListener('input', () => {
  input.style.height = 'auto';
  input.style.height = Math.min(input.scrollHeight, 120) + 'px';
});

/* =========================================================================
   Voice input (Web Speech API — Chrome / Edge). Transcribes speech into
   the text box; the message is still sent as TEXT to the coach.
   ========================================================================= */
const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
let recognition = null;
let listening = false;

const SILENCE_MS = 1000;   // ← your grace period. This is the knob you wanted. Mili Seconds
const MAX_RESTARTS = 8;

let silenceTimer = null;
let micActive = false;       // user wants the mic on until we decide to send
let intentionalStop = false; // did WE stop it, or did the browser?
let restartCount = 0;

if(SpeechRecognition){
  recognition = new SpeechRecognition();
  recognition.continuous = true;      // ← was false; this is the key change
  recognition.interimResults = true;
  recognition.lang = 'en-US';

  function armSilenceTimer(){
    clearTimeout(silenceTimer);
    silenceTimer = setTimeout(() => {
      dlog('silence timeout reached, closing turn');
      intentionalStop = true;
      try{ recognition.stop(); }catch(e){}
    }, SILENCE_MS);
  }

  function stopMic(){
    micActive = false;
    intentionalStop = true;
    clearTimeout(silenceTimer);
    try{ recognition.stop(); }catch(e){}
  }

  recognition.onstart = () => {
    listening = true;
    turnHandled = false;
    micBtn.classList.add('listening');
    voiceNote.classList.remove('hidden');
    dlog('recognition start');
  };

  recognition.onresult = (event) => {
    if(turnHandled){ dlog('late onresult ignored'); return; }
    let out = '', lastChunk = '';
    for(let i = 0; i < event.results.length; i++){
      const chunk = (event.results[i][0].transcript || '').trim();
      if(!chunk || chunk === lastChunk) continue;
      out += (out ? ' ' : '') + chunk;
      lastChunk = chunk;
    }
    input.value = out;
    armSilenceTimer();               // every word heard resets the countdown
    dlog('onresult', JSON.stringify(out));
  };

  recognition.onend = () => {
    clearTimeout(silenceTimer);
    dlog('recognition end — intentional:', intentionalStop,
         'micActive:', micActive, 'restarts:', restartCount);

    // Safari often ends on its own even with continuous=true.
    // If we didn't ask for it, quietly resume so the user's pause isn't fatal.
    if(!intentionalStop && micActive && restartCount < MAX_RESTARTS){
      restartCount++;
      try{
        recognition.start();
        armSilenceTimer();
        return;                      // stay in listening state, no UI flicker
      }catch(err){ dlog('restart failed', err.message); }
    }

    listening = false;
    micActive = false;
    micBtn.classList.remove('listening');
    voiceNote.classList.add('hidden');

    if(turnHandled) return;          // second onend — ignore
    turnHandled = true;
    if(input.value.trim()) handleSend();
  };

  recognition.onerror = (event) => {
    dlog('recognition error', event.error);
    if(event.error === 'no-speech' || event.error === 'aborted') return; // onend handles it
    stopMic();
    listening = false;
    micBtn.classList.remove('listening');
    voiceNote.classList.add('hidden');
  };

  let lastMicTap = 0;
  micBtn.addEventListener('click', () => {
    const now = Date.now();
    if(now - lastMicTap < 600) return;
    lastMicTap = now;
    if(listening || micActive){ stopMic(); return; }   // tap again = send now
    input.value = '';
    turnHandled = false;
    intentionalStop = false;
    restartCount = 0;
    micActive = true;
    try{ recognition.start(); }catch(err){ dlog('start() threw', err.message); }
  });
}else{
  micBtn.addEventListener('click', () => {
    alert('Voice input isn\'t supported in this browser. Try Chrome or Edge, or type your message.');
  });
}

</script>
<script>
/* =========================================================================
   Phone activation — only shown when opened from inside a course lesson
   ========================================================================= */
   (function activation(){
    var WORKER = 'https://coach-router.bookcoachai.workers.dev';
    var box = document.getElementById('activate');
    var btn = document.getElementById('activateBtn');
    var out = document.getElementById('activateOut');
    if(!box || !btn || !out) return;
  
    if(CONFIG.showActivation !== true){ box.remove(); return; }

    var q = new URLSearchParams(location.search);
    var contactId = (q.get('cid') || '').trim();
    var email     = (q.get('em')  || '').trim();
    // No identity, or unresolved merge fields: stay hidden rather than show a
    // button that cannot work.
    var hasIdentity = !!(contactId && email &&
    contactId.indexOf('{{') === -1 && email.indexOf('{{') === -1);

    box.hidden = false;

    // Ask whether this member already linked a handset, so someone who has is
    // not offered a code they do not need. Costs no KV writes server-side.
    function renderLinked(d){
      var list = (d.phones || []).join(', ');
      say('<span class="activate-ok"><span class="status-dot"></span> Phone linked</span>'
        + '<p class="activate-note">Text or call <span class="activate-num">' + (d.smsTo || '') + '</span>'
        + ' any time' + (list ? ' from ' + list : '') + '.</p>'
        + '<p class="activate-note" style="margin-top:6px">'
        + '<button type="button" class="activate-link" id="activateAgain">Using a different phone? Get a new code</button></p>');
      var again = document.getElementById('activateAgain');
      if(again) again.addEventListener('click', function(){ btn.hidden = false; say(''); });
    }
  
    // Take the identity out of the visible URL.
    if(window.history && window.history.replaceState){
      try{
        var u = new URL(location.href);
        u.searchParams.delete('cid'); u.searchParams.delete('em');
        history.replaceState({}, document.title, u.pathname + (u.search || '') + u.hash);
      }catch(e){}
    }
  
    function say(h){ out.innerHTML = h; }
  
    btn.addEventListener('click', function(){
        if(!hasIdentity){
            say('<p class="activate-note activate-err">You are not authorized to get the code yet.</p>');
            return;
        }
        btn.disabled = true;
      say('<p class="activate-note">Getting your code&hellip;</p>');
  
      fetch(WORKER + '/api/bind/mint', {
        method:'POST', headers:{'content-type':'application/json'},
        body: JSON.stringify({ contactId: contactId, email: email })
      })
      .then(function(r){ return r.json().catch(function(){return {};}).then(function(b){ return {s:r.status, b:b}; }); })
      .then(function(r){
        btn.disabled = false;
        if(r.s === 200 && r.b.token){
          var mins = Math.round((r.b.expiresInSeconds || 900) / 60);
          say('<p class="activate-note">Text this code to <span class="activate-num">' + (r.b.smsTo||'') + '</span></p>'
            + '<p class="activate-code">' + r.b.token + '</p>'
            + '<p class="activate-note">Expires in ' + mins + ' minutes and works once. '
            + 'Your coach replies as soon as it arrives.</p>');
        } else if(r.s === 429){
          say('<p class="activate-note activate-err">You have asked for several codes already. Please wait a little and try again.</p>');
        } else if(r.s === 403){
        say('<p class="activate-note activate-err">You are not authorized to get the code yet.</p>');
        } else {
          say('<p class="activate-note activate-err">Something went wrong. Please try again in a moment.</p>');
        }
      })
      .catch(function(err){
        btn.disabled = false;
        var msg = (err && err.message) ? err.message : 'unknown error';
        console.error('[activate] request failed:', err);
        say('<p class="activate-note activate-err">Could not reach the activation service.</p>'
          + '<p class="activate-note">Reason: ' + msg + '</p>'
          + '<p class="activate-note">If that says "Failed to fetch", an ad blocker or privacy '
          + 'extension is blocking the request. Try a private/incognito window.</p>');
      });
    });

    // Last, so the button is already wired if this returns "not linked".
    // Last, so the button is already wired if this returns "not linked".
    if(hasIdentity){
      fetch(WORKER + '/api/bind/status', {
        method:'POST', headers:{'content-type':'application/json'},
        body: JSON.stringify({ contactId: contactId, email: email })
      })
      .then(function(r){ return r.ok ? r.json() : null; })
      .then(function(d){ if(d && d.linked){ btn.hidden = true; renderLinked(d); } })
      .catch(function(){ /* leave the button showing - it still works */ });
    }
  })();
</script>
  
</body>
</html>
