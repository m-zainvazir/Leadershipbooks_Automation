<title>Book Coach AI</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --navy-deep: #0E1B33;
    --navy-panel: #142542;
    --navy-line: #223357;
    --brand-blue: #2C57A8;
    --brand-red: #E5352B;
    --arrow-orange: #F0932B;
    --arrow-yellow: #F4C430;
    --arrow-green: #4FAE5A;
    --arrow-skyblue: #4C7FD6;
    --ivory: #F3F1EA;
    --ivory-dim: #B7BFD1;
    --radius: 14px;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;height:100%;background:var(--navy-deep);font-family:'Inter',system-ui,sans-serif;color:var(--ivory);}
  body{
    display:flex;flex-direction:column;min-height:100vh;
    background:
      radial-gradient(1100px 700px at 12% -10%, rgba(44,87,168,0.25), transparent 60%),
      radial-gradient(900px 600px at 100% 110%, rgba(229,53,43,0.10), transparent 55%),
      var(--navy-deep);
  }

  /* ---------- Header / brand bar ---------- */
  header{
    display:flex;align-items:center;justify-content:space-between;
    padding:18px 28px;border-bottom:1px solid var(--navy-line);
    background:rgba(14,27,51,0.7);backdrop-filter:blur(6px);
    position:relative;z-index:5;
  }
  .brand{display:flex;align-items:center;gap:12px;}
  .brand img{height:34px;display:block;filter:drop-shadow(0 0 10px rgba(0,0,0,0.35));}
  .brand-divider{width:1px;height:24px;background:var(--navy-line);}
  .brand-sub{font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--ivory-dim);}
  .rainbow-strip{display:flex;gap:5px;align-items:flex-end;height:16px;}
  .rainbow-strip span{width:3px;border-radius:2px;display:block;transform:skewX(-12deg);}
  .rainbow-strip span:nth-child(1){height:60%;background:var(--brand-red);}
  .rainbow-strip span:nth-child(2){height:75%;background:var(--arrow-orange);}
  .rainbow-strip span:nth-child(3){height:100%;background:var(--arrow-yellow);}
  .rainbow-strip span:nth-child(4){height:82%;background:var(--arrow-green);}
  .rainbow-strip span:nth-child(5){height:66%;background:var(--arrow-skyblue);}
  .proto-tag{
    font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;
    color:var(--ivory-dim);border:1px solid var(--navy-line);border-radius:100px;padding:6px 14px;
  }

  /* ---------- Main layout ---------- */
  main{
    flex:1;display:grid;grid-template-columns: 360px 1fr;gap:0;
    max-width:1180px;width:100%;margin:0 auto;padding:32px 28px 40px;
    align-items:stretch;height:680px;
  }
  @media (max-width: 860px){
    main{grid-template-columns:1fr;gap:24px;height:auto;}
  }

  /* ---------- Presence panel (author) ---------- */
  .presence{
    background:linear-gradient(180deg, rgba(20,37,66,0.9), rgba(14,27,51,0.9));
    border:1px solid var(--navy-line);border-radius:var(--radius);
    padding:32px 26px;display:flex;flex-direction:column;align-items:center;text-align:center;
    height:100%;position:relative;overflow-y:auto;overflow-x:hidden;
    scrollbar-width:none;
  }
  .presence::-webkit-scrollbar{display:none;}
  @media (max-width: 860px){ .presence{height:auto;} }
  .presence::before{
    content:"";position:absolute;top:-40%;left:-20%;width:140%;height:140%;
    background:radial-gradient(circle, rgba(44,87,168,0.18), transparent 60%);
    pointer-events:none;
  }
  .photo-ring{
    width:150px;height:150px;border-radius:50%;position:relative;margin-bottom:18px;
    background:conic-gradient(from 180deg, var(--brand-red), var(--arrow-orange), var(--arrow-yellow), var(--arrow-green), var(--arrow-skyblue), var(--brand-red));
    padding:3px;
  }
  @media (prefers-reduced-motion: reduce){ .photo-ring{animation:none;} }
  @keyframes spin{ to{ transform:rotate(360deg); } }
  .photo-inner{
    width:100%;height:100%;border-radius:50%;background:var(--navy-panel);
    display:flex;align-items:center;justify-content:center;overflow:hidden;
    border:3px solid var(--navy-deep);
  }
  .photo-inner img{width:100%;height:100%;object-fit:cover;display:block;}
  .photo-placeholder{
    color:var(--ivory-dim);font-family:'Fraunces',serif;font-size:42px;font-weight:500;
  }
  .presence h1{
    font-family:'Fraunces',serif;font-weight:600;font-size:24px;margin:2px 0 4px;letter-spacing:.01em;
  }
  .presence .book-title{
    font-style:italic;color:var(--ivory-dim);font-size:14px;margin:0 0 16px;line-height:1.4;
  }
  .status-chip{
    display:inline-flex;align-items:center;gap:7px;
    font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.08em;text-transform:uppercase;
    color:#B9E6C4;background:rgba(79,174,90,0.12);border:1px solid rgba(79,174,90,0.35);
    padding:6px 12px;border-radius:100px;margin-bottom:22px;
  }
  .status-dot{width:6px;height:6px;border-radius:50%;background:#4FAE5A;box-shadow:0 0 0 0 rgba(79,174,90,0.6);animation:pulse 2s infinite;}
  @keyframes pulse{
    0%{box-shadow:0 0 0 0 rgba(79,174,90,0.55);}
    70%{box-shadow:0 0 0 7px rgba(79,174,90,0);}
    100%{box-shadow:0 0 0 0 rgba(79,174,90,0);}
  }
    .presence-links{
    display:flex;justify-content:center;flex-wrap:wrap;gap:10px;
    width:100%;max-width:300px;margin:0 auto 22px;
  }
  .presence-links:empty{display:none;}
  .presence-btn{
    flex:1 1 auto;min-width:132px;text-align:center;
    font-family:'JetBrains Mono',monospace;font-size:11px;font-weight:500;
    letter-spacing:.08em;text-transform:uppercase;text-decoration:none;
    padding:11px 16px;border-radius:100px;
    transition:background .15s,border-color .15s,transform .12s;
  }
  .presence-btn:hover{transform:translateY(-1px);}
  .presence-btn.primary{
    background:var(--brand-blue);border:1px solid var(--brand-blue);color:var(--ivory);
  }
  .presence-btn.primary:hover{background:#3866c4;border-color:#3866c4;}
  .presence-btn.secondary{
    background:transparent;border:1px solid var(--navy-line);color:var(--ivory-dim);
  }
  .presence-btn.secondary:hover{border-color:var(--brand-blue);color:var(--ivory);}
  /* --- Meet the author (fixed link, no dropdown) --- */
.author-btn{
  flex:0 0 auto;
  display:block;width:100%;max-width:300px;margin:0 auto 14px;
  background:transparent;
  border:1px solid rgba(244,196,48,0.45);
  color:var(--arrow-yellow);
}
.author-btn:hover{
  transform:none;
  border-color:var(--arrow-yellow);
  background:rgba(244,196,48,0.10);
  color:var(--arrow-yellow);
}

/* --- phone activation ------------------------------------------------- */
.activate{
  margin-top:14px;padding:14px;text-align:left;
  background:rgba(255,255,255,0.03);
  border:1px solid var(--navy-line);border-radius:10px;
}
.activate-label{
  font-family:'JetBrains Mono',monospace;font-size:11px;font-weight:500;
  letter-spacing:.08em;text-transform:uppercase;color:var(--ivory-dim);margin:0 0 6px;
}
.activate-copy{
  font-family:'Inter',sans-serif;font-size:12.5px;line-height:1.5;
  color:var(--ivory-dim);margin:0 0 12px;
}
.activate-out{margin-top:12px;}
.activate-code{
  font-family:'JetBrains Mono',monospace;font-size:26px;font-weight:500;
  letter-spacing:.22em;color:var(--ivory);margin:6px 0 4px;
}
.activate-note{
  font-family:'Inter',sans-serif;font-size:11.5px;line-height:1.5;
  color:var(--ivory-dim);margin:0;
}
.activate-num{color:var(--arrow-skyblue);}
.activate-err{color:#F2A9A4;}
/* linked state - mirrors .status-chip so "on" reads the same everywhere */
.activate-ok{
  display:inline-flex;align-items:center;gap:7px;
  font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.08em;text-transform:uppercase;
  color:#B9E6C4;background:rgba(79,174,90,0.12);border:1px solid rgba(79,174,90,0.35);
  padding:6px 12px;border-radius:100px;margin:0 0 10px;
}
.activate-link{
  background:none;border:0;padding:0;cursor:pointer;
  font-family:'Inter',sans-serif;font-size:11.5px;
  color:var(--arrow-skyblue);text-decoration:underline;
}
.activate-link:hover{color:var(--ivory);}

.book-menu-wrap{position:relative;flex:1 1 auto;min-width:132px;}
.book-menu-wrap .presence-btn{width:100%;display:block;cursor:pointer;}
.book-menu{
position:absolute;bottom:calc(100% + 8px);left:0;right:0;
background:var(--navy-panel);border:1px solid var(--navy-line);
border-radius:10px;padding:6px;display:none;flex-direction:column;gap:2px;
box-shadow:0 12px 28px rgba(0,0,0,.45);z-index:20;
}
.book-menu-wrap:hover .book-menu,
.book-menu-wrap.open .book-menu{display:flex;}
.book-menu-wrap::after{content:"";position:absolute;bottom:100%;left:0;right:0;height:10px;}
.book-menu a{
display:block;padding:9px 12px;border-radius:7px;text-decoration:none;
color:var(--ivory);font-family:'Inter',sans-serif;font-size:12.5px;
line-height:1.35;text-align:left;
}
.book-menu a:hover{background:rgba(44,87,168,.28);}
  @media (prefers-reduced-motion: reduce){ .presence-btn:hover{transform:none;} }
  .presence-note{
    font-size:12.5px;line-height:1.55;color:var(--ivory-dim);border-top:1px solid var(--navy-line);
    padding-top:16px;margin-top:4px;
  }
  .presence-note strong{color:var(--ivory);}

  /* ---------- Chat panel ---------- */
  .chat-panel{
    background:var(--navy-panel);border:1px solid var(--navy-line);
    border-radius:var(--radius);margin-left:24px;
    display:flex;flex-direction:column;height:100%;overflow:hidden;
  }
  @media (max-width: 860px){ .chat-panel{margin-left:0;height:640px;} }

  .chat-head{
    padding:16px 22px;border-bottom:1px solid var(--navy-line);
    display:flex;align-items:center;justify-content:space-between;
  }
  .chat-head-title{font-family:'Fraunces',serif;font-size:16px;font-weight:500;}
  .chat-head-sub{font-family:'JetBrains Mono',monospace;font-size:10.5px;color:var(--ivory-dim);letter-spacing:.06em;}

  .messages{
    flex:1;overflow-y:auto;padding:22px;display:flex;flex-direction:column;gap:14px;
  }
  .msg{max-width:78%;padding:12px 15px;border-radius:12px;font-size:14.5px;line-height:1.5;}
  .msg.coach{
    align-self:flex-start;background:rgba(44,87,168,0.16);border:1px solid rgba(44,87,168,0.35);
    border-bottom-left-radius:4px;
  }
  .msg.user{
    align-self:flex-end;background:rgba(229,53,43,0.14);border:1px solid rgba(229,53,43,0.32);
    border-bottom-right-radius:4px;
  }
  .msg-label{
    font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.08em;text-transform:uppercase;
    color:var(--ivory-dim);margin-bottom:5px;display:block;
  }
  .typing{align-self:flex-start;display:flex;gap:4px;padding:12px 15px;}
  .typing span{width:6px;height:6px;border-radius:50%;background:var(--ivory-dim);animation:bounce 1.2s infinite;}
  .typing span:nth-child(2){animation-delay:.15s;} .typing span:nth-child(3){animation-delay:.3s;}
  @keyframes bounce{ 0%,60%,100%{transform:translateY(0);opacity:.4;} 30%{transform:translateY(-4px);opacity:1;} }

  .composer{
    border-top:1px solid var(--navy-line);padding:16px 18px;display:flex;gap:10px;align-items:flex-end;
    background:rgba(14,27,51,0.4);
  }
  .composer textarea{
    flex:1;resize:none;background:var(--navy-deep);border:1px solid var(--navy-line);
    border-radius:10px;color:var(--ivory);font-family:'Inter',sans-serif;font-size:14.5px;
    padding:11px 13px;line-height:1.4;max-height:120px;
  }
  .composer textarea:focus{outline:none;border-color:var(--brand-blue);}
  .icon-btn{
    width:42px;height:42px;border-radius:10px;border:1px solid var(--navy-line);
    background:var(--navy-deep);color:var(--ivory);display:flex;align-items:center;justify-content:center;
    cursor:pointer;flex-shrink:0;transition:border-color .15s, background .15s;
  }
  .icon-btn:hover{border-color:var(--brand-blue);}
  .icon-btn.mic.listening{
    background:var(--brand-red);border-color:var(--brand-red);
    animation:mic-pulse 1.4s infinite;
  }
  @keyframes mic-pulse{
    0%{box-shadow:0 0 0 0 rgba(229,53,43,0.5);}
    70%{box-shadow:0 0 0 9px rgba(229,53,43,0);}
    100%{box-shadow:0 0 0 0 rgba(229,53,43,0);}
  }
  .send-btn{
    background:var(--brand-blue);border:1px solid var(--brand-blue);
  }
  .send-btn:hover{background:#3866c4;border-color:#3866c4;}
  .icon-btn svg{width:19px;height:19px;}
  .voice-note{
    font-family:'JetBrains Mono',monospace;font-size:10.5px;color:var(--ivory-dim);
    padding:0 18px 14px;letter-spacing:.03em;
  }
  .voice-note.hidden{display:none;}
</style>
