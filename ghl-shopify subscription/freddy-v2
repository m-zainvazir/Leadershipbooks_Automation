<body>

<header>
  <div class="brand">
    <a href="http://leadershipbooks.com/" target="_blank" rel="noopener" class="brand-link">
      <img src="data:image/png;base64," alt="Leadership Books">
    </a>
    <div class="brand-divider"></div>


    <div>
      <div class="brand-sub">Book Coach AI</div>
    </div>
  </div>
  <div style="display:flex;align-items:center;gap:16px;">
    <div class="rainbow-strip">
      <span></span><span></span><span></span><span></span><span></span>
    </div>
    <div class="proto-tag">Type or Talk</div>
  </div>
</header>

<main>
  <section class="presence">
    <div class="photo-ring">
      <div class="photo-inner">
        <!-- Swap this block for <img src="AUTHOR_PHOTO_URL" alt="Author Name"> when a photo is supplied -->
